# 依赖
node_modules/

# 构建产物
out/
dist/
/release/
*.tsbuildinfo

# 运行日志（运行时产物，绝不入库）
log/
# 资格验收隔离工作区（与受保护的默认日志目录分离）
/.h3b-workspaces/
# 单测在 logger 未初始化时触发的 CWD 日志（既有 provider 告警用例等，运行测试即重现）
/aibrowse-*.log

# 环境变量与密钥（本地文件，绝不入库）
.env
.env.*

# 测试覆盖率产物
coverage/

# IDE / 编辑器个人配置
.idea/
.vscode/

# 系统杂项
Thumbs.db
.DS_Store
npm-debug.log*
